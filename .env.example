# Copy to .env and adjust. All values are optional, the defaults are the safe ones.
# .env is gitignored; never commit real values.

# Flask session signing key. Unset means a new random key is generated on each
# start, which logs out existing sessions on restart. Set it to keep sessions
# across restarts. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECULOG_SECRET_KEY=

# Set to 1 to enable Werkzeug's interactive debugger. This is remote code
# execution for anyone who can reach the port. Local development only.
SECULOG_DEBUG=0

# Bind address. Defaults to 127.0.0.1 (localhost only). Changing this to
# 0.0.0.0 exposes the dashboard to your network, which has no authentication.
SECULOG_HOST=127.0.0.1
SECULOG_PORT=5000
